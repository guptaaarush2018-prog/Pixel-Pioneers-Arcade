{
  "rules": {
    ".read": false,
    ".write": false,

    "scores": {
      "$game": {
        ".read": true,
        ".indexOn": ["score"],
        "$player": {
          ".write": "!data.exists() || newData.child('score').val() > data.child('score').val()",
          ".validate": "newData.hasChildren(['name', 'score', 't']) && newData.child('score').isNumber() && newData.child('score').val() >= 0 && newData.child('score').val() < 100000000 && newData.child('name').isString() && newData.child('name').val().matches(/^[A-Z][a-z]+[A-Z][a-z]+[0-9]{2}$/) && newData.child('t').val() <= now",
          "$other": { ".validate": "$other === 'name' || $other === 'score' || $other === 't'" }
        }
      }
    },

    "presence": {
      ".read": true,
      ".indexOn": ["t"],
      "$player": {
        ".write": true,
        ".validate": "newData.hasChildren(['at', 't']) && newData.child('at').isString() && newData.child('at').val().length <= 32 && newData.child('t').val() <= now"
      }
    },

    "ghosts": {
      "$track": {
        ".read": true,
        ".write": "!data.exists() || newData.child('time').val() < data.child('time').val()",
        ".validate": "newData.hasChildren(['name', 'time', 'frames', 't']) && newData.child('time').isNumber() && newData.child('time').val() > 10 && newData.child('frames').isString() && newData.child('frames').val().length < 60000 && newData.child('name').val().matches(/^[A-Z][a-z]+[A-Z][a-z]+[0-9]{2}$/)"
      }
    },

    "rooms": {
      "$code": {
        ".read": true,
        ".write": "$code.matches(/^[A-Z]{4}$/)",
        ".validate": "newData.hasChildren(['game', 'status'])",
        "moves": {
          "$move": {
            ".validate": "newData.hasChildren(['l', 'p', 'r']) && newData.child('l').isNumber() && (newData.child('p').val() === 0 || newData.child('p').val() === 1) && newData.child('r').isNumber()"
          }
        }
      }
    }
  }
}
